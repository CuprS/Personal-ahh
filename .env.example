# Copy this file to .env.local and fill in the values.
# Without these, the contact form logs messages to the terminal in development
# and shows a "not set up yet" message in production.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form messages are delivered
CONTACT_TO_EMAIL=

# Optional: sender address. Must be on a domain you've verified in Resend.
# Defaults to Resend's test sender (onboarding@resend.dev), which can only send to your own Resend account email.
CONTACT_FROM_EMAIL=
